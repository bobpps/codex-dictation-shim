# Copy to `.env` next to this file. Every value below is a default the shim
# already uses, so an empty `.env` behaves exactly like no `.env` at all.
#
# The reader is deliberately minimal: `KEY=VALUE`, one per line, `#` starts a
# comment only at the beginning of a line, and surrounding single or double
# quotes are stripped. There is no interpolation, no `export`, no multi-line
# value. A real environment variable always wins over a line in this file, so a
# service unit can override anything without editing it.

# ── Server ───────────────────────────────────────────────────────────────────
# Handy's base URL must be http://SHIM_HOST:SHIM_PORT/v1
#
# Do not bind 0.0.0.0. This endpoint has no authentication — Handy's API key is
# ignored, since Handy sends whatever string it is given — so off the loopback
# interface anyone who can reach the port can ask for the transcript of whatever
# was just dictated. The shim warns loudly if you do it anyway.
SHIM_HOST=127.0.0.1
SHIM_PORT=8756

# ── Handy ────────────────────────────────────────────────────────────────────
# Absolute path to Handy's `recordings/` directory. Leave empty to probe the
# per-platform candidates; set it when Handy runs in portable mode or from a
# non-default data directory. `/health` always reports the path actually used.
HANDY_RECORDINGS_DIR=

# ── Codex credentials ────────────────────────────────────────────────────────
# Directory holding `auth.json`. Empty means ~/.codex, which is where both the
# CLI and the desktop app write it.
CODEX_HOME=

# ── Codex transcribe endpoint ────────────────────────────────────────────────
# The endpoint is undocumented and the client pin is a consumable: when old
# client versions start being rejected, this is the line to edit, and editing a
# setting must not mean editing source.
CODEX_TRANSCRIBE_URL=https://chatgpt.com/backend-api/transcribe
CODEX_ORIGINATOR=codex_desktop
CODEX_USER_AGENT=Codex Desktop/26.611.62324

# Optional BCP-47 hint sent with the audio. Empty means "let the endpoint
# decide", which is what you want unless you dictate in exactly one language.
# "auto" is not a value the endpoint knows and is never sent.
CODEX_LANGUAGE=

# Upload plus transcription for a long dictation. Handy shows its processing
# overlay for the whole wait, so this is also the longest the user stares at it.
CODEX_TIMEOUT_MS=120000

# ── Recording guards ─────────────────────────────────────────────────────────
# Refuse a WAV older than this. The recording is written before post-processing
# runs, so anything old is not the dictation being processed right now.
MAX_AGE_SEC=60

# A file is settled once its mtime has stopped moving for SETTLE_QUIET_MS. When
# the recording finished writing seconds ago — the normal case, since Handy
# awaits and verifies the WAV before calling post-processing — this costs one
# stat and no waiting at all.
#
# Must be at least 1. Zero would make any file look settled on the first stat,
# which is the still-being-written guard switched off, and that guard is not
# optional: without it a growing WAV is sent truncated.
SETTLE_QUIET_MS=150
SETTLE_POLL_MS=50
SETTLE_TIMEOUT_MS=3000

# Handy sends the draft transcript in the request body. A megabyte of draft is
# already absurd; anything past it is not Handy.
MAX_BODY_BYTES=1048576

# ── Logging ──────────────────────────────────────────────────────────────────
# error | warn | info | debug
SHIM_LOG_LEVEL=info

# Off by default on purpose: with this on, every log line quotes what you said.
# Turn it on to debug a specific mismatch, then turn it off and delete the log.
#
# It also governs unexpected response bodies from the endpoint. A 200 carrying
# plain text instead of JSON could be the transcript, so by default such a body
# is reported as its status, content type, and length rather than quoted.
SHIM_LOG_TRANSCRIPTS=0

# ── Token keepalive ──────────────────────────────────────────────────────────
# The access token lives ten days, but the CLI only refreshes it while it runs.
# A box where nobody types `codex` for a fortnight has a dead token and no
# warning. This runs `codex login status` on a timer to keep the file fresh.
# Under launchd or systemd the PATH is minimal, so prefer an absolute path.
KEEPALIVE_ENABLED=1
KEEPALIVE_INTERVAL_HOURS=24
KEEPALIVE_TIMEOUT_MS=60000
# Keep exactly one CODEX_CLI_BIN assignment uncommented. The default below
# works when a directly runnable Codex executable is on the server's PATH.
# Absolute paths depend on your installation; the examples are not auto-detected.
# Replace YOUR_USER and verify the file exists. This file does not expand ~,
# $HOME, %APPDATA%, or other variables, and does not run shell commands.
#
# Windows (npm installation, x64): use the native .exe, not codex.cmd or codex.ps1.
# CODEX_CLI_BIN=C:/Users/YOUR_USER/AppData/Roaming/npm/node_modules/@openai/codex/node_modules/@openai/codex-win32-x64/vendor/x86_64-pc-windows-msvc/bin/codex.exe
# To locate the actual executable in your global npm installation, run in PowerShell:
# Get-ChildItem -LiteralPath (npm root -g) -Filter codex.exe -Recurse | Select-Object -ExpandProperty FullName
# Use the executable matching your machine's architecture.
#
# macOS: run `command -v codex` in the terminal where Codex works and copy its
# absolute path. Example for an installation under /opt/homebrew:
# CODEX_CLI_BIN=/opt/homebrew/bin/codex
#
# Linux: run `command -v codex` in the terminal where Codex works and copy its
# absolute path. Example for an installation under /usr/local:
# CODEX_CLI_BIN=/usr/local/bin/codex
#
# npm launchers on macOS/Linux also need node on the server's PATH.
CODEX_CLI_BIN=codex
