<?xml version="1.0" encoding="UTF-16"?>
<!--
  Windows Task Scheduler definition.

    install: schtasks /Create /TN "Codex Dictation Shim" /XML service\task-scheduler.xml
    start:   schtasks /Run /TN "Codex Dictation Shim"
    check:   curl -s localhost:8756/health
    remove:  schtasks /Delete /TN "Codex Dictation Shim" /F

  Replace YOU in the three paths below, and confirm the node path with
  `where node`.

  Two settings are load-bearing rather than boilerplate:

  - `ExecutionTimeLimit` is PT0S, meaning no limit. The default is three days,
    after which Task Scheduler would kill a perfectly healthy shim and the next
    dictation would quietly fall back to the local transcript.
  - `RestartOnFailure` covers a crash; `DisallowStartIfOnBatteries` is off
    because a laptop on battery is exactly when someone dictates.

  Task Scheduler starts the process with the machine PATH, not the one from
  your shell profile, so CODEX_CLI_BIN is set through the `.env` file rather
  than assumed. There is no environment block in this format.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Local OpenAI-compatible endpoint that swaps Handy's local transcript for Codex dictation.</Description>
    <URI>\Codex Dictation Shim</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Program Files\nodejs\node.exe</Command>
      <Arguments>C:\Users\YOU\src\codex-dictation-shim\src\shim.mjs</Arguments>
      <WorkingDirectory>C:\Users\YOU\src\codex-dictation-shim</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
